#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
DRY_RUN=0
FORCE_WITH_LEASE=0
REMOTE="origin"
BRANCH=""

usage() {
  cat >&2 <<'USAGE'
usage: scripts/agent-push [--dry-run] [--force-with-lease] [remote-name [branch]]

Runs AgentOS validation, scans the HEAD publication tree, optionally scans the
staged index when staged changes exist, then pushes the current branch by
default. Direct pushes to main are refused. Force, mirror, all, delete, tag,
and raw refspec pushes are refused. --force-with-lease is allowed only for the
current non-main branch after the same validation gates pass.
USAGE
}

quote_command() {
  local quoted=()
  local arg
  for arg in "$@"; do
    printf -v arg "%q" "$arg"
    quoted+=("$arg")
  done
  printf "%s\n" "${quoted[*]}"
}

refuse_dangerous_push_args() {
  local arg
  for arg in "$@"; do
    case "$arg" in
      -f|--force|--force=*|--force-with-lease=*|--force-if-includes|--force-if-includes=*)
        echo "error: refusing force push argument: $arg" >&2
        exit 2
        ;;
      --mirror|--all|--tags|--follow-tags)
        echo "error: refusing broad or tag push argument: $arg" >&2
        exit 2
        ;;
      -d|--delete|--delete=*)
        echo "error: refusing delete push argument: $arg" >&2
        exit 2
        ;;
      +*)
        echo "error: refusing force refspec: $arg" >&2
        exit 2
        ;;
      :*)
        echo "error: refusing delete refspec: $arg" >&2
        exit 2
        ;;
      refs/tags/*|tag)
        echo "error: refusing tag push argument: $arg" >&2
        exit 2
        ;;
    esac
    if git -C "$ROOT" show-ref --verify --quiet "refs/tags/$arg"; then
      echo "error: refusing push of local tag name: $arg" >&2
      exit 2
    fi
  done
}

POSITIONAL=()
while [[ "$#" -gt 0 ]]; do
  case "$1" in
    --dry-run)
      DRY_RUN=1
      shift
      ;;
    --force-with-lease)
      FORCE_WITH_LEASE=1
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    -*)
      echo "error: unsupported push option: $1" >&2
      usage
      exit 2
      ;;
    *)
      POSITIONAL+=("$1")
      shift
      ;;
  esac
done

if [[ "${#POSITIONAL[@]}" -gt 2 ]]; then
  usage
  exit 2
fi
POSITIONAL_COUNT="${#POSITIONAL[@]}"
if [[ "$POSITIONAL_COUNT" -gt 0 ]]; then
  refuse_dangerous_push_args "${POSITIONAL[@]}"
fi

CURRENT_BRANCH="$(git -C "$ROOT" symbolic-ref --quiet --short HEAD)" || {
  echo "error: refusing to push from detached HEAD" >&2
  exit 2
}

if [[ "$POSITIONAL_COUNT" -ge 1 ]]; then
  REMOTE="${POSITIONAL[0]}"
fi
if [[ "$POSITIONAL_COUNT" -eq 2 ]]; then
  BRANCH="${POSITIONAL[1]}"
else
  BRANCH="$CURRENT_BRANCH"
fi

case "$REMOTE" in
  *:*|+*|refs/*|HEAD|tag)
    echo "error: refusing remote argument that looks like a URL, ref, or refspec: $REMOTE" >&2
    echo "Use a configured remote name such as origin." >&2
    exit 2
    ;;
esac

case "$BRANCH" in
  *:*|+*|refs/*|HEAD|tag)
    echo "error: refusing raw ref or refspec branch argument: $BRANCH" >&2
    exit 2
    ;;
esac

if [[ "$CURRENT_BRANCH" == "main" || "$BRANCH" == "main" ]]; then
  cat >&2 <<'MESSAGE'
error: refusing to push main directly.

AgentOS Core/public changes must be made on a feature branch in an isolated
worktree, opened as a pull request, validated by GitHub Actions, and squash
merged into main.
MESSAGE
  exit 2
fi

if [[ "$BRANCH" != "$CURRENT_BRANCH" ]]; then
  echo "error: refusing to push branch '$BRANCH' while current branch is '$CURRENT_BRANCH'" >&2
  exit 2
fi

PUSH_ARGS=()
if [[ "$FORCE_WITH_LEASE" == "1" ]]; then
  PUSH_ARGS+=("--force-with-lease=refs/heads/$BRANCH")
fi
PUSH_ARGS+=("$REMOTE" "$BRANCH")

echo "Running AgentOS default validation..."
python3 "$ROOT/os/verification/scripts/validate_agentos.py"

echo "Scanning HEAD publication tree..."
"$ROOT/scripts/check_publication_tree_secrets.sh" HEAD

if ! git -C "$ROOT" diff --cached --quiet --; then
  echo "Scanning staged publication tree..."
  "$ROOT/scripts/check_staged_publication_secrets.sh"
fi

if [[ "$DRY_RUN" == "1" ]]; then
  if [[ "$FORCE_WITH_LEASE" == "1" ]]; then
    echo "Dry run: would run AGENTOS_AGENT_PUSH_FORCE_WITH_LEASE=1 $(quote_command git push "${PUSH_ARGS[@]}")"
  else
    echo "Dry run: would run $(quote_command git push "${PUSH_ARGS[@]}")"
  fi
  exit 0
fi

if [[ "$FORCE_WITH_LEASE" == "1" ]]; then
  AGENTOS_AGENT_PUSH_FORCE_WITH_LEASE=1 git -C "$ROOT" push "${PUSH_ARGS[@]}"
else
  git -C "$ROOT" push "${PUSH_ARGS[@]}"
fi
