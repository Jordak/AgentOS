{
  "version": 1,
  "benchmarks": [
    {
      "id": "retrieval",
      "script": "os/verification/retrieval/scripts/benchmark_retrieval.py",
      "reports_dir": "personal/os/verification/retrieval/reports",
      "run_glob": "*/run.json",
      "summary_path": ["harness", "summary"],
      "weekly_review": {
        "check_freshness": false
      }
    },
    {
      "id": "playbook-activation",
      "script": "os/verification/playbook-activation/scripts/benchmark_playbook_activation.py",
      "reports_dir": "personal/os/verification/playbook-activation/reports",
      "run_glob": "*/run.json",
      "summary_path": ["summary"],
      "weekly_review": {
        "check_freshness": false
      }
    },
    {
      "id": "guidance-eval",
      "script": "os/verification/guidance-eval/scripts/benchmark_guidance_eval.py",
      "reports_dir": "personal/os/verification/guidance-eval/reports",
      "run_glob": "*/run.json",
      "summary_path": ["summary"],
      "weekly_review": {
        "check_freshness": true,
        "min_status_counting_total": 8,
        "max_age_days": 14
      }
    }
