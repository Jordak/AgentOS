{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AgentOS Retrieval Harness Response",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "answer",
    "cited_paths",
    "evidence",
    "confidence",
    "notes"
  ],
  "properties": {
    "answer": {
      "type": "string",
      "minLength": 1
    },
    "cited_paths": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "locator",
          "quote"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "locator": {
            "type": "string"
          },
          "quote": {
            "type": "string",
            "minLength": 1,
            "maxLength": 280
          }
        }
      }
    },
    "confidence": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high"
      ]
    },
    "notes": {
      "type": "string"
    }
  }
}
